{
  "$defs": {
    "StoppageKind": {
      "enum": [
        "throw_in",
        "goal_kick",
        "corner",
        "free_kick",
        "penalty",
        "offside",
        "goal",
        "substitution",
        "injury",
        "card",
        "var",
        "half_time",
        "full_time"
      ],
      "title": "StoppageKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clock_ms": {
      "minimum": 0,
      "title": "Clock Ms",
      "type": "integer"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "expected_dead_ms": {
      "minimum": 0,
      "title": "Expected Dead Ms",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/StoppageKind"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "period_id": {
      "enum": [
        1,
        2
      ],
      "title": "Period Id",
      "type": "integer"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "restart_team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Restart Team Id"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "type": {
      "const": "stoppage_start",
      "default": "stoppage_start",
      "title": "Type",
      "type": "string"
    },
    "wall_ms": {
      "minimum": 0,
      "title": "Wall Ms",
      "type": "integer"
    },
    "x": {
      "anyOf": [
        {
          "maximum": 105.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "X"
    },
    "y": {
      "anyOf": [
        {
          "maximum": 68.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Y"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "period_id",
    "clock_ms",
    "wall_ms",
    "kind",
    "restart_team_id",
    "expected_dead_ms"
  ],
  "title": "StoppageStart",
  "type": "object"
}
