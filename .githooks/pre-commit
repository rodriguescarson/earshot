#!/usr/bin/env bash
# Scan staged changes for secrets (SEC3), then format and lint staged Python, before every commit.
set -euo pipefail
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  echo "pre-commit: gitleaks is not installed; secrets are still scanned in CI (brew install gitleaks)" >&2
fi
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
uv run ruff format $files
# shellcheck disable=SC2086
uv run ruff check --fix $files
# shellcheck disable=SC2086
git add $files
