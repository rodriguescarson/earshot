{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "earshot-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "web",
        "dev",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173
    },
    {
      "name": "earshot-live",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env; set +a; EARSHOT_MATCH_DIR=data/live-matches EARSHOT_LIVE_SPEED=3 EARSHOT_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174 exec uv run uvicorn earshot.live.app:app --host 127.0.0.1 --port 8787"
      ],
      "port": 8787,
      "url": "http://127.0.0.1:8787"
    },
    {
      "name": "earshot-web-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_LIVE_BASE=http://127.0.0.1:8787",
        "corepack",
        "pnpm",
        "--dir",
        "web",
        "dev",
        "--host",
        "127.0.0.1",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
